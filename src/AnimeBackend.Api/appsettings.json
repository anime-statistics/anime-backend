{
  "Urls": "http://localhost:5000",
  "ConnectionStrings": {
    "Default": "Data Source=data/anime.db"
  },
  "Sources": {
    "Shikimori": {
      "BaseUrl": "https://shikimori.io",
      "UserAgent": "anime-statistics-backend",
      "SearchLimit": 50
    },
    "AniLiberty": {
      "BaseUrl": "https://api.anilibria.app",
      "AssetsBaseUrl": "https://anilibria.top",
      "CatalogPageSize": 50
    }
  },
  "Storage": {
    "AttachmentsPath": "data/attachments",
    "PublicPath": "/attachments"
  },
  "Cors": {
    "Origins": ["http://localhost:5173", "http://localhost:4173"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backend-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
